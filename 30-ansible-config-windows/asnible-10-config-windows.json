---
- name: Create domain user and add to local Administrators
  hosts: windows
  gather_facts: true

  vars:
    ansible_connection: winrm
    ansible_winrm_transport: kerberos          # Kerberos so the control node's TGT is used
    ansible_winrm_kerberos_delegation: true    # forward TGT so the target can query AD
    ansible_port: 5986
    ansible_winrm_server_cert_validation: ignore
    domain_netbios: "vmware"
    domain_fqdn: "vmware.wei"
    domain_join_user: "VMware\\administrator"        # only used by the commented-out join task
    domain_join_password: "ChangeMe!JoinP@ss"  # override with Ansible Vault
    admin_username: "CaC-IaC-Class"
    admin_password: "ChangeMe!Str0ngP@ss"      # override with Ansible Vault
    admin_upn: "{{ admin_username }}@{{ domain_fqdn }}"
    admin_ou: ""                               # e.g. "OU=Service Accounts,DC=wei,DC=vmware,DC=wei"; blank uses default Users container

  pre_tasks:
    - name: Verify control node holds a valid Kerberos TGT (klist -s)
      ansible.builtin.command: klist -s
      delegate_to: localhost
      run_once: true
      changed_when: false
      failed_when: false
      register: control_node_tgt

    - name: Fail if the control node has no valid TGT
      ansible.builtin.fail:
        msg: >-
          No valid Kerberos ticket on the control node. Run
          'kinit youradmin@{{ domain_fqdn | upper }}' and re-run this playbook.
      run_once: true
      when: control_node_tgt.rc != 0

    - name: Verify target is joined to {{ domain_fqdn }} with a healthy secure channel
      ansible.windows.win_shell: nltest /sc_query:{{ domain_fqdn }}
      changed_when: false
      failed_when: false
      register: target_secure_channel

    - name: Verify target can see a Kerberos TGT for the delegated session
      ansible.windows.win_shell: klist tgt
      changed_when: false
      failed_when: false
      register: target_tgt

    - name: Record domain credential validation result
      ansible.builtin.set_fact:
        domain_context_ok: >-
          {{ ansible_facts['windows_domain_member'] | default(false) | bool
             and target_secure_channel.rc == 0
             and 'NERR_Success' in target_secure_channel.stdout
             and target_tgt.rc == 0 }}

    # If the target is NOT domain-joined, uncomment to join it first.
    # NOTE: joining requires a reboot before domain credentials are usable.
    # - name: Join {{ inventory_hostname }} to {{ domain_fqdn }}
    #   microsoft.ad.membership:            # formerly ansible.windows.win_domain_membership
    #     dns_domain_name: "{{ domain_fqdn }}"
    #     domain_admin_user: "{{ domain_join_user }}"
    #     domain_admin_password: "{{ domain_join_password }}"
    #     state: domain
    #     reboot: true                      # handles the required reboot
    #   no_log: true
    #   when: not (ansible_facts['windows_domain_member'] | default(false) | bool)

    - name: Fail host if domain credential validation did not pass
      ansible.builtin.fail:
        msg: >-
          Domain context check failed on {{ inventory_hostname }}.
          domain_member={{ ansible_facts['windows_domain_member'] | default('unknown') }},
          nltest_rc={{ target_secure_channel.rc }}, klist_rc={{ target_tgt.rc }}.
          Join the host (see commented task) or fix Kerberos delegation.
      when: not (domain_context_ok | bool)

  tasks:
    - name: Create user and grant local admin only after credential validation
      when: domain_context_ok | bool
      block:
        - name: Create domain user {{ admin_username }}
          community.windows.win_domain_user:
            name: "{{ admin_username }}"
            upn: "{{ admin_upn }}"
            password: "{{ admin_password }}"
            state: present
            account_locked: false
            path: "{{ admin_ou | default(omit, true) }}"
          no_log: true
          run_once: true

        - name: Add {{ domain_netbios }}\{{ admin_username }} to local Administrators group
          ansible.windows.win_group_membership:
            name: Administrators
            members:
              - "{{ domain_netbios }}\\{{ admin_username }}"
            state: present





































